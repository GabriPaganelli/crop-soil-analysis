.Rproj.user
.Rhistory
.RData
.Ruserdata

# CmdStan output: chain CSVs, compiled binary, large MCMC fit files (GB-sized)
stan/*.csv
stan/*.json
stan/*.exe
stan/fit_*.rds
stan/risultati_*.RData

# Cache R oggetti rigenerabili (projpred, LOO, pareto_k) — possono essere grandi
output/cache/*.rds

# File temporanei e plotting
scripts/_tmp_*.R
Rplots.pdf

# LaTeX ausiliari e PDF compilato (il deliverable finale sta alla root)
report/*.aux
report/*.log
report/*.blg
report/*.bbl
report/*.out
report/*.toc
report/*.fdb_latexmk
report/*.fls
report/*.synctex*
report/compile_log.txt
report/*.pdf
report/images/

# Docs ausiliari
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc

# Log nella cache (pattern più ampio)
output/cache/log_*.txt

# Log di esecuzione pipeline
output/log_*.txt
output/log_*.R

# LOO output del modello GP (rigenerabile da run_loo_gp.R)
output/loo_gp.rds
